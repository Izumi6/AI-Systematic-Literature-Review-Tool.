# ---------------------------------------------------------------
# AI Systematic Literature Review Tool — Environment Variables
# ---------------------------------------------------------------
# Copy this file to .env and fill in your actual values.
# Never commit your real .env file to version control.

# Required: API key for paper analysis and survey generation
# Supports OpenAI, Groq, DeepSeek, OpenRouter, or any OpenAI-compatible provider
API_KEY=your_api_key_here

# Optional: LLM model identifier (default: gpt-4o-mini)
# Examples: gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, deepseek-chat
LLM_MODEL=gpt-4o-mini

# Optional: Custom API Base URL (leave blank for standard OpenAI)
# Examples: https://api.groq.com/openai/v1, https://openrouter.ai/api/v1
API_BASE_URL=

# Optional: Semantic Scholar API key for higher rate limits
# Leave blank to use the free tier (limited to ~100 requests/5 min)
SEMANTIC_SCHOLAR_API_KEY=

# Optional: Override the sentence-transformer embedding model
# Default: all-MiniLM-L6-v2  (fast, good quality)
# Alternative: all-mpnet-base-v2  (higher quality, slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2
